# Copy this file to .env and fill in your values. Never commit .env.
PORT=3000

# Optional: get contact messages by email (Gmail with an App Password)
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_TO=your-gmail@gmail.com

# Optional: key to read saved messages at /api/messages
ADMIN_KEY=choose-a-long-random-string
